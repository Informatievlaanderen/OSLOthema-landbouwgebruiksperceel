@prefix landbouwgebruiksperceel: <https://implementatie.data.vlaanderen.be/ns/lv/landbouwgebruiksperceel#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix terms: <http://purl.org/dc/terms/> .
@prefix core: <http://www.w3.org/2004/02/skos/core#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix rov: <http://www.w3.org/ns/regorg#> .
@prefix organisatie: <http://data.vlaanderen.be/id/organisatie/> .
@prefix schema: <https://schema.org/> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix adres: <https://data.vlaanderen.be/ns/adres#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix identificatortype: <https://data.vlaanderen.be/id/concept/Identificatortype/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix onderneming: <https://implementatie.data.vlaanderen.be/ns/vkbo/onderneming#> .

<https://example.org/id/organisatie/6>
	rdf:type org:Organization ;
	core:prefLabel "GOEDLEVEN"@nl ;
	adms:identifier [ rdf:type adms:Identifier ;
		core:notation "4301603527"^^identificatortype:Klantnummer ;
		terms:creator organisatie:OVO000082
	] ;
	rov:orgType <https://data.vlaanderen.be/id/concept/Rechtsvormtype/v1/610> ;
	schema:contactPoint [ rdf:type schema:ContactPoint ;
		schema:telephone "09 222 33 44"^^vcard:Voice ;
		locn:address [ rdf:type locn:Address ;
			locn:postCode "4508" ;
			locn:thoroughfare "SLECHTLEVEN"@nl ;
			adres:huisnummer "12" ;
			adres:gemeentenaam "PE Landkerkje"@nl ;
			adres:land "Nederland"@nl ;
			locn:fullAddress "SLECHTLEVEN 12, 4508 PE LANDKERKJE, NEDERLAND"@nl
		]
	] .

<https://data.vlaanderen.be/id/landbouwgebruiksperceel/102601672708618>
	rdf:type landbouwgebruiksperceel:Landbouwgebruiksperceel ;
	adms:identifier [ rdf:type adms:Identifier ;
		core:notation "10260_1672708618"^^identificatortype:AGPAKEY ;
		terms:creator organisatie:OVO000082
	] ;
	landbouwgebruiksperceel:gebruiker <https://example.org/id/organisatie/6> .

organisatie:OVO000082
	rdf:type rov:RegisteredOrganization ;
	core:prefLabel "Agentschap Landbouw en Zeevisserij"@nl ;
	rov:registration _:registratie_OVO000082 .

_:registratie_OVO000082
	rdf:type adms:Identifier ;
	core:notation "OVO000082"^^identificatortype:OVOCode .

<https://data.vlaanderen.be/id/concept/Rechtsvormtype/v1/610>
	rdf:type onderneming:Rechtsvormtype ;
	core:notation "610" ;
	core:prefLabel "Besloten Vennootschap"@nl .

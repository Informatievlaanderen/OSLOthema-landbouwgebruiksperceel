@prefix landbouwgebruiksperceel: <https://implementatie.data.vlaanderen.be/ns/lv/landbouwgebruiksperceel#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix terms: <http://purl.org/dc/terms/> .
@prefix core: <http://www.w3.org/2004/02/skos/core#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix rov: <http://www.w3.org/ns/regorg#> .
@prefix organisatie: <http://data.vlaanderen.be/id/organisatie/> .
@prefix persoon: <https://data.vlaanderen.be/ns/persoon#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix adres: <https://data.vlaanderen.be/ns/adres#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix identificatortype: <https://data.vlaanderen.be/id/concept/Identificatortype/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix organisatiens: <https://data.vlaanderen.be/ns/organisatie#> .
@prefix onderneming: <https://implementatie.data.vlaanderen.be/ns/vkbo/onderneming#> .

<https://example.org/id/organisatie/5>
	rdf:type rov:RegisteredOrganization ;
	core:prefLabel "BERNOUTS FRANS"@nl ;
	adms:identifier [ rdf:type adms:Identifier ;
		core:notation "11655659"^^identificatortype:Klantnummer ;
		terms:creator organisatie:OVO000082
	] ;
	rov:registration [ rdf:type adms:Identifier ;
		core:notation "687387728"^^identificatortype:Ondernemingsnummer ;
		terms:creator organisatie:OVO027341
	] ;
	rov:orgActivity <https://data.vlaanderen.be/id/concept/Activiteitstype/gerelateerd> ;
	rov:orgStatus <https://data.vlaanderen.be/id/concept/OrganisatieStatus/v1/AC> ;
	organisatiens:rechtspersoonlijkheid <https://data.vlaanderen.be/id/concept/Rechtspersoonlijkheidtype/v1/1> ;
	org:member <https://data.vlaanderen.be/id/persoon/5> ;
	schema:contactPoint [ rdf:type schema:ContactPoint ;
		schema:email "naamvoornaam@mail.be" ;
		schema:telephone "0456 78 91 23"^^vcard:Cell ;
		locn:address [ rdf:type locn:Address ;
			locn:postCode "1234" ;
			locn:thoroughfare "Rokstraat"@nl ;
			adres:huisnummer "10" ;
			adres:gemeentenaam "Overal"@nl ;
			landbouwgebruiksperceel:gemeentecode "44099" ;
			adres:land "België"@nl ;
			locn:fullAddress "Rokstraat 10, 1234 Overal"@nl
		]
	] .

<https://data.vlaanderen.be/id/persoon/5>
	rdf:type persoon:GeregistreerdPersoon ;
	persoon:registratie [ rdf:type adms:Identifier ;
		core:notation "16579840245"^^identificatortype:INSZ ;
		terms:creator organisatie:OVO008218
	] ;
	foaf:familyName "Bernouts" ;
	foaf:givenName "Frans" ;
	landbouwgebruiksperceel:isOverleden false .

<https://data.vlaanderen.be/id/landbouwgebruiksperceel/102601783119270>
	rdf:type landbouwgebruiksperceel:Landbouwgebruiksperceel ;
	adms:identifier [ rdf:type adms:Identifier ;
		core:notation "10260_1783119270"^^identificatortype:AGPAKEY ;
		terms:creator organisatie:OVO000082
	] ;
	landbouwgebruiksperceel:gebruiker <https://example.org/id/organisatie/5> .

organisatie:OVO000082
	rdf:type rov:RegisteredOrganization ;
	core:prefLabel "Agentschap Landbouw en Zeevisserij"@nl ;
	rov:registration _:registratie_OVO000082 .

_:registratie_OVO000082
	rdf:type adms:Identifier ;
	core:notation "OVO000082"^^identificatortype:OVOCode .

organisatie:OVO027341
	rdf:type rov:RegisteredOrganization ;
	core:prefLabel "Kruispuntbank van Ondernemingen"@nl ;
	rov:registration _:registratie_OVO027341 .

_:registratie_OVO027341
	rdf:type adms:Identifier ;
	core:notation "OVO027341"^^identificatortype:OVOCode .

organisatie:OVO008218
	rdf:type rov:RegisteredOrganization ;
	core:prefLabel "Kruispuntbank van de Sociale Zekerheid"@nl ;
	rov:registration _:registratie_OVO008218 .

_:registratie_OVO008218
	rdf:type adms:Identifier ;
	core:notation "OVO008218"^^identificatortype:OVOCode .

<https://data.vlaanderen.be/id/concept/Activiteitstype/gerelateerd>
	rdf:type onderneming:Activiteittype ;
	core:notation "gerelateerd" ;
	core:prefLabel "Gerelateerde landbouwactiviteit"@nl .

<https://data.vlaanderen.be/id/concept/OrganisatieStatus/v1/AC>
	rdf:type onderneming:OrganisatieStatus ;
	core:notation "AC" ;
	core:prefLabel "Actief"@nl .

<https://data.vlaanderen.be/id/concept/Rechtspersoonlijkheidtype/v1/1>
	rdf:type onderneming:Rechtspersoonlijkheidtype ;
	core:notation "1" ;
	core:prefLabel "Natuurlijk Persoon"@nl .

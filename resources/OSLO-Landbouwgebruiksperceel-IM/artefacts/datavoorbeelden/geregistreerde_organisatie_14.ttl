<https://example.org/id/organisatie/14>
	rdf:type rov:RegisteredOrganization ;
	rov:registration [ rdf:type adms:Identifier;
					  core:notation "2199335537";
					  terms:creator organisatie:OVO027341
					] ;
	rov:registration [ rdf:type adms:Identifier;
					  core:notation "00015614774";
					  terms:creator organisatie:OVO000082
					] ;
	rov:orgStatus <https://data.vlaanderen.be/id/concept/OrganisatieStatus/v1/AC> ;
	core:prefLabel "AGENTSCHAP VOOR NATUUR EN BOS (ANB) -HOOFDZETEL"@nl ;
	schema:contactPoint [ rdf:type schema:ContactPoint ;
						  schema:email "anb@vlaanderen.be";
						  locn:address [ rdf:type locn:Address;
		                                        locn:postCode      "1000";
		                                        locn:thoroughfare  "Havenlaan"@nl;
		                                        adres:huisnummer "88";
		                                        locn:poBox "75";
		                                        adres:gemeentenaam "Brussel"@nl;
		                                        adres:land "België"@nl;
		                                        locn:fullAddress "HAVENLAAN 88 bus 75, 1000 BRUSSEL"@nl
						               ]
	] .

<https://data.vlaanderen.be/id/landbouwgebruiksperceel/102601770790772>
	rdf:type landbouwgebruiksperceel:Landbouwgebruiksperceel ;

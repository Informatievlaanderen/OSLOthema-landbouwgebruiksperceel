<https://data.vlaanderen.be/id/persoon/6>
	rdf:type persoonw3c:Person ;
	adms:identifier [ rdf:type adms:Identifier;
					  core:notation "34000621";
					  terms:creator organisatie:OVO000082
					] ;
	foaf:familyName "DOMS" ;
	foaf:givenName "AGNES" ;
	schema:contactPoint [ rdf:type schema:ContactPoint ;
						  schema:telephone "+31765972123"^^vcard:Voice;
						  schema:email "ervoor@boomkwekdams.nl";
						  locn:address [ rdf:type locn:Address;
		                                        locn:postCode      "4661";
		                                        locn:thoroughfare  "ACHWEG"@nl;
		                                        adres:huisnummer "121";
		                                        locn:poBox "B";
		                                        adres:gemeentenaam "AZ ZUNDERT"@nl;
		                                        adres:land "Nederland"@nl;
		                                        locn:fullAddress "ACHWEG 121 bus B, 4661 AZ ZUNDERT, NEDERLAND"@nl
						               ]
	] .

<https://data.vlaanderen.be/id/landbouwgebruiksperceel/102601770789964>
	rdf:type landbouwgebruiksperceel:Landbouwgebruiksperceel ;

<https://data.vlaanderen.be/id/landbouwgebruiksperceel/102601820939570>
	rdf:type landbouwgebruiksperceel:Landbouwgebruiksperceel ;
	adms:identifier [ rdf:type adms:Identifier;
					  core:notation "10260_1820939570";
					  terms:creator organisatie:OVO000082
					] ;
	landbouwgebruiksperceel:uitbater <https://example.org/id/organisatie/9> .
	

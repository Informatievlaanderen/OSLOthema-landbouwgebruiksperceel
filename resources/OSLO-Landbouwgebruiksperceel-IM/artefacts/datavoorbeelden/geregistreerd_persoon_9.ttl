					  terms:creator organisatie:OVO008218
					] ;
	adms:identifier [ rdf:type adms:Identifier;
					  core:notation "305792193";
					  terms:creator organisatie:OVO000082
					] ;
	foaf:familyName "Tuinier" ;
	foaf:givenName "Maria" ;
	schema:contactPoint [ rdf:type schema:ContactPoint ;
						  schema:email "Maria@hemel.nl";
						  schema:telephone "+21 45 78 89 4"^^vcard:Voice;
						  locn:address [ rdf:type locn:Address;
		                                        locn:postCode      "11123";
		                                        locn:thoroughfare  "BROEKSTRAAT"@nl;
		                                        adres:huisnummer "5";
		                                        adres:gemeentenaam "DAAR"@nl;
		                                        adres:land "Nederland"@nl;
		                                        locn:fullAddress "Broekstraat 5, 11123 DAAR"@nl
						               ]
	] .


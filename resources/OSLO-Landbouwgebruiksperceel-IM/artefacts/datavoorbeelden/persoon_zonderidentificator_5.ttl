<https://data.vlaanderen.be/id/persoon/5>
	rdf:type persoonw3c:Person ;
	adms:identifier [ rdf:type adms:Identifier;
					  core:notation "33331927";
					  terms:creator organisatie:OVO000082
					] ;
	foaf:familyName "BROENS" ;
	foaf:givenName "JOHANA" ;
	schema:contactPoint [ rdf:type schema:ContactPoint ;
						  schema:telephone "+25 67 89 12 56 7"^^vcard:Cell;
						  locn:address [ rdf:type locn:Address;
		                                        locn:postCode      "6561";
		                                        locn:thoroughfare  "WEIDE"@nl;
		                                        adres:huisnummer "42";
		                                        adres:gemeentenaam "NZ ELSLOO"@nl;
		                                        adres:land "Nederland"@nl;
		                                        locn:fullAddress "WEIDE 42, 6561 NZ ELSLOO, NEDERLAND"@nl
						               ]
	] .

<https://data.vlaanderen.be/id/landbouwgebruiksperceel/102601577152807>
	rdf:type landbouwgebruiksperceel:Landbouwgebruiksperceel ;
	adms:identifier [ rdf:type adms:Identifier;
					  core:notation "10260_1577152807";
					  terms:creator organisatie:OVO000082
					] ;
	landbouwgebruiksperceel:uitbater <https://data.vlaanderen.be/id/persoon/5> .
	

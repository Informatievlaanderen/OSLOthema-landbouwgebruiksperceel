<https://data.vlaanderen.be/id/persoon/8>
	rdf:type persoon:GeregistreerdPersoon ;
	persoon:registratie [ rdf:type adms:Identifier;
					  core:notation "16579840241";
					  terms:creator organisatienl:10103
					] ;
	adms:identifier [ rdf:type adms:Identifier;
					  core:notation "38804949";
					  terms:creator organisatie:OVO000082
					] ;
	foaf:familyName "Spring" ;
	foaf:givenName "Schans" ;
	schema:contactPoint [ rdf:type schema:ContactPoint ;
						  schema:email "Springschans@mail.be";
						  schema:telephone "+21 45 78 89 3"^^vcard:Voice;
						  schema:telephone "+21 31 54 97 2"^^vcard:Cell;
						  locn:address [ rdf:type locn:Address;
		                                        locn:postCode      "1111";
		                                        locn:thoroughfare  "BROEKSTRAAT"@nl;
		                                        adres:huisnummer "4";
		                                        adres:gemeentenaam "Nergens"@nl;
		                                        adres:land "Nederland"@nl;
		                                        locn:fullAddress "Broekstraat 4, 1111 Nergens"@nl
						               ]
	] .

<https://data.vlaanderen.be/id/landbouwgebruiksperceel/102621791336180>
	rdf:type landbouwgebruiksperceel:Landbouwgebruiksperceel ;

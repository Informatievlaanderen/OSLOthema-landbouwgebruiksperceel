        "parameters": [
          {
            "name": "agpakey",
            "required": true,
            "in": "path",
            "description": "De AGPAKEY die het Landbouwgebruiksperceel uniek identificeert.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Correlation-Id",
            "required": true,
            "in": "header",
            "description": "Correlatie ID van het request.",
            "schema": {
              "type": "string",
              "minLength": 10,
              "maxLength": 36
            }
          }
        ],
